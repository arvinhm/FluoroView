{
  // fluoroview.com: static files only, no Worker script.
  "name": "fluoroview-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // No public *.workers.dev or preview addresses: the site is reached only through its own domain,
  // where the Cloudflare Access policy applies.
  "workers_dev": false,
  "preview_urls": false,
  // A route on the existing proxied hostname: no DNS records are created or changed.
  "routes": [{ "pattern": "fluoroview.com/*", "zone_name": "fluoroview.com" }]
}
